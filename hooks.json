{
  "description": "notion-doc: checks that written HTML documents follow the style canon.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/notion-doc-lint.py",
            "timeout": 10,
            "statusMessage": "Checking notion-doc canon..."
          }
        ]
      }
    ]
  }
}
